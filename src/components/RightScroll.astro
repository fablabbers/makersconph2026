    </span>

    <div>
    <h2
        class="
        mb-20
        text-4xl
        font-black
        uppercase
        leading-[0.85]
        tracking-[-0.07em]
        md:text-6xl
        "
    >
        About
    </h2>

    <p
        class="
        max-w-2xl
        text-3xl
        leading-tight
        tracking-tight
        md:text-5xl
        "
