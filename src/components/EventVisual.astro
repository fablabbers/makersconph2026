</aside>


<script>
  const svg =
    document.querySelector<SVGSVGElement>("#tile-art");

  if (!svg) {
    throw new Error("Tile SVG not found");
  }

  const SVG_NS =
    "http://www.w3.org/2000/svg";

  const palette = [
    "#111111",
    "#ff5c5c",
    "#f5c542",
    "#3d8bfd",
    "#f15bb5",
    "#55c78a"
  ];

  //const columns = 6;
  const columns = window.innerWidth > 500 ? 12 : 6;
  const rows = 6;
  const size = window.innerWidth / columns;


  class Tile {
    x: number;
    y: number;
    size: number;
    type: "square" | "quarter" | "triangle";
    orientation: number;
    color: string;

    constructor(x: number, y: number, size: number) {
      this.x = x;
      this.y = y;
      this.size = size;

      this.type =
        ["square", "quarter", "triangle"][
          Math.floor(Math.random() * 3)
        ];

      this.orientation =
        Math.floor(Math.random() * 4);

      this.color =
        palette[
          Math.floor(
            Math.random() * palette.length
          )
        ];
    }
  }


  function createTile(tile: Tile): SVGGElement {
    const group =
      document.createElementNS(
        SVG_NS,
        "g"
      );

    group.setAttribute(
      "transform",
      `
        translate(${tile.x} ${tile.y})
        rotate(
          ${tile.orientation * 90}
          ${tile.size / 2}
          ${tile.size / 2}
        )
      `
    );

    group.setAttribute(
      "style",
      "opacity: 0; transition: opacity 1400ms ease-out;"
    );

    group.addEventListener("mouseenter", () => {
      group.style.transition = "opacity 10ms ease-in";
      group.style.opacity = "1";
    });

    group.addEventListener("mouseleave", () => {
      group.style.transition = "opacity 1400ms ease-out";
      group.style.opacity = "0";
    });


    if (tile.type === "square") {
      const rect =
        document.createElementNS(
          SVG_NS,
          "rect"
        );

      rect.setAttribute(
        "width",
        tile.size
      );

      rect.setAttribute(
        "height",
        tile.size
      );

      rect.setAttribute(
        "fill",
        tile.color
      );

      group.appendChild(rect);
    }


    if (tile.type === "triangle") {
      const triangle =
        document.createElementNS(
          SVG_NS,
          "polygon"
        );

      triangle.setAttribute(
        "points",
        `
          0,0
          ${tile.size},0
          0,${tile.size}
        `
      );

      triangle.setAttribute(
        "fill",
        tile.color
      );

      group.appendChild(triangle);
    }


    if (tile.type === "quarter") {
      const path =
        document.createElementNS(
          SVG_NS,
          "path"
        );

      path.setAttribute(
        "d",
        `
          M 0 0
          A ${tile.size} ${tile.size}
          0 0 1
          ${tile.size} ${tile.size}
          L 0 ${tile.size}
          Z
        `
      );

      path.setAttribute(
        "fill",
        tile.color
      );

      group.appendChild(path);
    }


    return group;
  }


  for (let row = 0; row < rows; row++) {
    for (let col = 0; col < columns; col++) {

      const tile = new Tile(
        col * size,
        row * size,
        size
      );

      svg.appendChild(
        createTile(tile)
      );
    }
  }
</script>

